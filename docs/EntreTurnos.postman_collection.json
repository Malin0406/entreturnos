{
  "info": {
    "name": "EntreTurnos API",
    "description": "Coleção para testar a API do EntreTurnos. Execute \"Login (demo)\" primeiro: o token JWT é salvo automaticamente na variável {{token}}. Substitua :id pelos identificadores retornados nas listagens.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3333/api"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "categoryId",
      "value": ""
    },
    {
      "key": "id",
      "value": ""
    }
  ],
