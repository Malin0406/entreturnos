    {
      "name": "Autenticação",
      "item": [
        {
          "name": "Login (demo)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "if (data.token) { pm.collectionVariables.set(\"token\", data.token); }",
                  "pm.test(\"Status 2xx\", () => pm.response.to.be.success);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"demo@entreturnos.com\",\n  \"password\": \"Demo@1234\"\n}"
            }
          }
        },
        {
          "name": "Cadastro",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "if (data.token) { pm.collectionVariables.set(\"token\", data.token); }",
                  "pm.test(\"Status 2xx\", () => pm.response.to.be.success);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
