# Porta da API
PORT=3333

# Conexão com o PostgreSQL (mesmos dados do docker-compose.yml)
DATABASE_URL="postgresql://entreturnos:entreturnos@localhost:5432/entreturnos?schema=public"

# Banco usado pelos testes de integração (schema separado, é recriado a cada execução)
DATABASE_URL_TEST="postgresql://entreturnos:entreturnos@localhost:5432/entreturnos?schema=test"

# Segredo do JWT — troque por um valor longo e aleatório
JWT_SECRET="troque-este-segredo-por-um-valor-longo-e-aleatorio"
JWT_EXPIRES_IN="7d"

# Origem permitida para CORS (endereço do frontend)
CORS_ORIGIN="http://localhost:5173"

# Em desenvolvimento, o token de redefinição de senha é devolvido na resposta da API
# (não há serviço de e-mail). Em produção, deixe "production".
NODE_ENV="development"
